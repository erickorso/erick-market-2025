# Free key: https://finnhub.io/register
FINNHUB_API_KEY=

# Local BFF port (Vite proxies /api → this)
MARKET_API_PORT=4010

# Neon Postgres connection string
DATABASE_URL=

# Dedicated Neon branch/project for integration tests; never use production here
DATABASE_URL_TEST=

# Auth0 (server — JWT validation)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Auth0 (Vite client — must be prefixed with VITE_)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Extra CORS origins, comma separated. Production, localhost:5173 and this
# project's Vercel preview URLs are already allowed without listing them.
ALLOWED_ORIGINS=
