{
  "name": "stock-market-simulator",
  "private": true,
  "version": "1.2.0",
  "description": "Stock market trading simulator — React, TypeScript, Vite, Three.js + Finnhub BFF (Erick Vargas)",
  "author": "Erick Vargas Ramos <erickorso@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/dev-api.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @screenshots",
    "screenshots": "playwright test --project=screenshots",
    "test:e2e:ui": "playwright test --ui",
    "db:schema": "node -e \"console.log('Run: psql \\\"$DATABASE_URL\\\" -f db/schema.sql')\"",
    "smoke": "node scripts/smoke.mjs",
    "check:db": "node scripts/check-neon-schema.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.23.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.7.0",
    "jose": "^6.2.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.3",
    "three": "^0.167.0",
    "web-vitals": "^6.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.167.0",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
