{
  "name": "stock-market-simulator",
  "private": true,
  "version": "1.2.0",
  "description": "Stock market trading simulator — React, TypeScript, Vite, Three.js + Finnhub BFF (Erick Vargas)",
  "author": "Erick Vargas Ramos <erickorso@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/dev-api.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:schema": "node -e \"console.log('Run: psql \\\"$DATABASE_URL\\\" -f db/schema.sql')\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.23.0",
    "@neondatabase/serverless": "^1.1.0",
    "jose": "^6.2.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^2.15.3",
    "three": "^0.167.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.167.0",
    "@types/ws": "^8.18.1",
    "@vercel/node": "^5.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
