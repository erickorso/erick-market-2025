{
  "expo": {
    "name": "Erick Market",
    "slug": "erick-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "erickmarket",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f172a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.erickmarket.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Erick Market uses the camera only to take your profile photo."
      }
    },
    "android": {
      "package": "app.erickmarket.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-asset",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Erick Market uses the camera only to take your profile photo. Nothing is recorded and the camera is off unless that screen is open."
        }
      ],
      [
        "react-native-auth0",
        {
          "domain": "dev-wfdctrtgoj8cy2tr.us.auth0.com"
        }
      ]
    ],
    "extra": {
      "apiBase": "https://erick-market-2025.vercel.app",
      "auth0Domain": "dev-wfdctrtgoj8cy2tr.us.auth0.com",
      "auth0ClientId": "XAuLCOcUeosqbjWojU3bDjWKUHLxGxf3",
      "auth0Audience": "https://erick-market-api",
      "router": {},
      "eas": {
        "projectId": "1eea1055-63b4-4b28-bb69-5fd6a1a83a04"
      }
    },
    "owner": "erickorso"
  }
}
